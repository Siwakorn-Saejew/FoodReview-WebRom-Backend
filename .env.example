# คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env ไม่ถูก commit)

# ต้องตรงกับ POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB ใน docker-compose.yml
DATABASE_URL=postgres://postgres:secret@localhost:5432/kitchen?sslmode=disable

# ยาวอย่างน้อย 32 ตัวอักษร สุ่มได้ด้วย: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# origin ของหน้าเว็บที่อนุญาต คั่นด้วยจุลภาค (ตอน deploy ใส่โดเมน Vercel ของทีม)
ALLOWED_ORIGINS=http://localhost:3000

# พอร์ตของ API: 4000 ตรงกับ "proxy" ในหน้าเว็บ React (ถ้าไม่ตั้ง จะใช้ 8080)
PORT=4000
